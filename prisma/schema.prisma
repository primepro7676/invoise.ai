generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique(map: "Admin_email_key")
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())

  @@map("admin")
}

model CompanySettings {
  id                   String   @id @default("singleton")
  primeproName         String   @default("PrimePro Technologies AI LLC")
  primeproTagline      String   @default("USA Headquarters")
  primeproAddress      String   @default("8 The Green, Suite B, Dover, Delaware 19901")
  primeproRegistration String   @default("LLC · Delaware, USA")
  primeproEIN          String   @default("36-5171970")
  primeproPhone        String   @default("+1 302 719 6746")
  primeproWhatsapp     String   @default("+1 302 719 6746")
  primeproEmail        String   @default("hello@primepro.ai")
  primeproLinkedin     String   @default("")
  primeproLogoUrl      String   @default("")
  fueloName            String   @default("Fuelo Technologies OPC Pvt Ltd")
  fueloTagline         String   @default("India Office")
  fueloCIN             String   @default("U72900KA2022OPC166090")
  fueloGSTIN           String   @default("29AAFCE2179R1ZT")
  fueloAddress         String   @default("Kasturi Nagar, Outer Ring Road, Bengaluru — 560043")
  fueloPhone           String   @default("+91 88888 57588")
  fueloWhatsapp        String   @default("+91 88888 57588")
  fueloEmail           String   @default("support@primepro.ai")
  fueloLinkedin        String   @default("")
  fueloLogoUrl         String   @default("")
  upiId                String   @default("yourupi@bank")
  qrCodeUrl            String   @default("")
  signatureUrl         String   @default("")
  signatoryLine1       String   @default("Authorised Signature for")
  signatoryLine2       String   @default("Fuelo Technologies OPC Pvt Ltd")
  defaultGstPercent    Float    @default(18)
  footerNote           String   @default("Thank you for choosing us. This is a computer generated invoice.")
  updatedAt            DateTime @updatedAt

  @@map("companysettings")
}

model Customer {
  id             String    @id @default(cuid())
  companyName    String
  contactPerson  String    @default("")
  billingAddress String
  city           String
  state          String
  pincode        String
  country        String    @default("India")
  phone          String
  email          String?
  gstin          String    @default("")
  placeOfSupply  String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoices       Invoice[]

  @@map("customer")
}

model GeneralTerms {
  id      String @id @default("singleton")
  content String @default("1. GST is calculated at 18% unless otherwise specified on the invoice.\n2. Payments are due according to the invoice due date.\n3. Additional services requested after confirmation may incur additional charges.\n4. Customer is responsible for providing accurate information and required access.") @db.Text

  @@map("generalterms")
}

model Invoice {
  id                  String            @id @default(cuid())
  invoiceNumber       String            @unique(map: "Invoice_invoiceNumber_key")
  invoiceDate         DateTime
  dueDate             DateTime
  paymentStatus       PaymentStatus     @default(UNPAID)
  customerId          String
  gstEnabled          Boolean           @default(true)
  gstPercent          Float             @default(18)
  subtotal            Float             @default(0)
  discountAmount      Float             @default(0)
  taxableAmount       Float             @default(0)
  gstAmount           Float             @default(0)
  grandTotal          Float             @default(0)
  amountPaid          Float             @default(0)
  balanceDue          Float             @default(0)
  amountInWords       String            @default("")
  paymentMethod       String            @default("UPI")
  upiId               String            @default("")
  transactionRef      String            @default("")
  selectedCategoryIds String            @default("")
  notes               String            @default("") @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  customer            Customer          @relation(fields: [customerId], references: [id], map: "Invoice_customerId_fkey")
  lineItems           InvoiceLineItem[]

  @@index([customerId], map: "Invoice_customerId_fkey")
  @@map("invoice")
}

model InvoiceLineItem {
  id            String  @id @default(cuid())
  invoiceId     String
  categoryName  String
  packageName   String
  description   String  @default("")
  quantity      Float   @default(1)
  rate          Float
  isCustomPrice Boolean @default(false)
  discount      Float   @default(0)
  gstPercent    Float   @default(18)
  total         Float
  sortOrder     Int     @default(0)
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade, map: "InvoiceLineItem_invoiceId_fkey")

  @@index([invoiceId], map: "InvoiceLineItem_invoiceId_fkey")
  @@map("invoicelineitem")
}

model Package {
  id          String          @id @default(cuid())
  name        String
  price       Float
  description String          @default("")
  isCustom    Boolean         @default(false)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  categoryId  String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "Package_categoryId_fkey")

  @@index([categoryId], map: "Package_categoryId_fkey")
  @@map("package")
}

model PackageBundle {
  id                String   @id @default(cuid())
  name              String
  subtitle          String   @default("")
  tier              String   @default("Premium")
  items             String   @db.Text
  totalPrice        Float    @default(0)
  discountPrice     Float    @default(0)
  finalPrice        Float    @default(0)
  platformsIncluded String   @default("") @db.Text
  deliverables      String   @default("") @db.Text
  paymentTerms      String   @default("") @db.Text
  specialNote       String   @default("")
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("packagebundle")
}

model ServiceCategory {
  id          String              @id @default(cuid())
  name        String              @unique(map: "ServiceCategory_name_key")
  description String              @default("")
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  packages    Package[]
  terms       TermsAndConditions?

  @@map("servicecategory")
}

model TermsAndConditions {
  id         String          @id @default(cuid())
  categoryId String          @unique(map: "TermsAndConditions_categoryId_key")
  content    String          @db.Text
  updatedAt  DateTime        @updatedAt
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "TermsAndConditions_categoryId_fkey")

  @@map("termsandconditions")
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}
